PORT=8081
# Reutiliza la misma base de datos PostgreSQL que el backend Python
# (mismo host/usuario/clave/BD que backend/.env, en formato URL de pgx).
DATABASE_URL=postgres://postgres:<contraseña>@localhost:5432/Cloude?sslmode=disable
UPLOADS_DIR=./uploads
# Errores técnicos (además de la consola). Se crea el directorio si no existe.
LOG_ARCHIVO=logs/errores.log
# Clave que firma los tokens de sesión. OBLIGATORIA: el servicio no arranca sin ella.
# Genérala con `openssl rand -hex 32` (mínimo 32 caracteres) y no la compartas ni la subas al repositorio.
JWT_SECRET=
