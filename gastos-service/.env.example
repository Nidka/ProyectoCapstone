PORT=8081
# Reutiliza la misma base de datos PostgreSQL que el backend Python
# (mismo host/usuario/clave/BD que backend/.env, en formato URL de pgx).
DATABASE_URL=postgres://postgres:<contraseña>@localhost:5432/Cloude?sslmode=disable
UPLOADS_DIR=./uploads
# Errores técnicos (además de la consola). Se crea el directorio si no existe.
LOG_ARCHIVO=logs/errores.log
# Clave que firma los tokens de sesión. OBLIGATORIA: el servicio no arranca sin ella.
# Genérala con `openssl rand -hex 32` (mínimo 32 caracteres) y no la compartas ni la subas al repositorio.
JWT_SECRET=

# --- Base de datos en Neon (PostgreSQL 17 en la nube) ---
# Neon exige SSL. Copia la cadena de conexión desde el panel de Neon (Connect) y úsala como DATABASE_URL:
#   postgres://USUARIO:CLAVE@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# - Usa el host DIRECTO (sin "-pooler") para el servicio: abre pocas conexiones y aplica las migraciones al arrancar.
# - Si usas el host con "-pooler" (PgBouncer), agrega al final: &default_query_exec_mode=simple_protocol
# - Quita el parámetro channel_binding si tu cadena lo trae.
# - La clave de Neon NUNCA se sube al repositorio: este archivo es solo un ejemplo; la real va en .env o en las variables del servidor.
